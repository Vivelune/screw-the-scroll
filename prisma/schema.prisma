// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStage {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id          String            @id @default(cuid())
  userId      String            // Clerk user id, added in Step 5
  company     String
  role        String
  jobUrl      String?
  location    String?
  stage       ApplicationStage  @default(WISHLIST)
  notes       String?
  appliedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
model JobListing {
  id            String   @id @default(cuid())
  source        String   // "arbeitnow" | "adzuna"
  externalId    String   // the ID from that source, for dedup
  title         String
  company       String
  location      String?
  country       String?
  url           String
  description   String?  @db.Text
  remote        Boolean  @default(false)
  visaSponsor   Boolean  @default(false) // Arbeitnow tag, refined in Phase 3
  postedAt      DateTime?
  createdAt     DateTime @default(now())

  @@unique([source, externalId])
}